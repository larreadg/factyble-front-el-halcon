# Proyecto de Supabase que espeja las facturas aprobadas por SIFEN.
# Copiar este archivo a .env.local y completar con los valores del proyecto.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Formulario publico de sorteos (/public/clientes).
# Base de las tres Edge Functions del flujo, SIN barra final:
#   verificar-telefono   paso 1, manda y confirma el PIN por SMS
#   consultar-documento  paso 2, resuelve el nombre contra el registro civil
#   registrar-cliente    paso 4, el alta
VITE_FUNCIONES_URL=https://<proyecto>.supabase.co/functions/v1
# Site key del widget de Turnstile. Es PUBLICA y viaja en el bundle: la secret
# key es la otra, y vive como secreto de la Edge Function.
VITE_TURNSTILE_SITE_KEY=
